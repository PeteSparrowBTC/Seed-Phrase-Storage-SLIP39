## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Published output - generated by CI/CD
publish/
**/publish/

# SSL certificates (if generated)
*.pem

# Playwright MCP session artifacts (screenshots, console logs)
.playwright-mcp/

# JS tooling for the independent-verify bundle — sources are committed, deps are not
tools/*/node_modules/

# Built distributables (AppImage etc.) — produced by packaging scripts / CI, never committed
dist/

# Superpowers brainstorming session scratch (ports/tokens) — machine-local
.superpowers/
*.key
*.crt

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml
# Local publish staging for the spike/desktop AppImage builds
pub-*/

# Leftover local clone of the patched AgeSharp fork, which this repository no longer
# uses (see Slip39Demo.Core.csproj: it consumes the released AgeSharp NuGet package).
# Ignored because it is a nested git repository, so a `git add -A` otherwise commits it
# as a gitlink pointing at a clone nobody else has. That happened once.
third_party/
.cargoprobe/
publish-tauri/
src-tauri/target/
# JSON schemas tauri-build regenerates from tauri.conf.json on every build, purely to
# give editors autocomplete on capability files. Not consumed by anything checked in.
src-tauri/gen/schemas/

# JetBrains Rider / IntelliJ. Four of these were committed once; the solution-level
# directory carries per-user layout and belongs to nobody but the machine it is on.
.idea/

# Scratch files used while diagnosing a dependency, kept out of the tree: they are
# throwaway reproductions, not tests, and a reader cannot tell which by the extension.
*.linq
*.csx
