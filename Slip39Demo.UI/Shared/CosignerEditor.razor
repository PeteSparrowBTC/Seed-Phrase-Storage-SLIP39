@using Slip39Demo.UI.Shared
@using Slip39Demo.Core.Bip32

<div class="panel">
    <div class="panel-header">
        <strong>Cosigner @(Index + 1)</strong>
        @if (Removable)
        {
            <button class="btn btn-sm btn-danger" @onclick="OnRemove">Remove</button>
        }
    </div>
    <div class="panel-body">
        <div class="field">
            <label class="field-label">ID</label>
            <input class="input" @bind="Vm.Id" @bind:after="NotifyChanged" placeholder="e.g. main, trezor, cosigner_a" />
        </div>

        <div class="field">
            <label class="field-label">Seed words (leave empty to use top-level seed)</label>
            <input class="input input-mono" @bind="Vm.SeedWords" @bind:after="NotifyChanged"
                   placeholder="abandon ability able about ..." />
        </div>

        <div class="field">
            <label class="field-label">Passphrase (optional)</label>
            <input class="input" @bind="Vm.Passphrase" @bind:after="NotifyChanged" placeholder="Leave empty if no passphrase" />
        </div>

        <div class="field">
            <label class="field-label">Derivation path</label>
            @* The placeholder never shows, because the field always has a value. It is
               there as the BIP-48 multisig path in the shape the descriptor builder
               accepts, so a reader who clears the field can see what belongs in it. *@
            <input class="input input-mono" @bind="Vm.DerivationPath" @bind:after="NotifyChanged"
                   placeholder="m/48'/0'/0'/2'" />
        </div>

        @* Wallet fingerprint is DERIVED from the seed + passphrase, not typed. The
           tool already has both, so it computes the same 8-hex-char master fingerprint
           your wallet software shows: a non-secret ID to confirm "this is the right
           wallet" at recovery. Read-only: nothing to fat-finger. *@
        <div class="field">
            <label class="field-label">Wallet fingerprint (auto-computed)</label>
            <input class="input input-mono" value="@ComputedFingerprint" readonly disabled
                   placeholder="—" />
            <div class="hint">@FingerprintHint</div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public CosignerVm Vm { get; set; } = null!;
    [Parameter] public int Index { get; set; }
    [Parameter] public bool Removable { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }

    // Editing a bound field mutates the shared Vm and re-renders THIS editor, but not
    // the parent — so the parent's live cosigner warnings/duplicate-block would go
    // stale. Firing this callback after each change makes the parent re-render.
    [Parameter] public EventCallback OnChanged { get; set; }

    Task NotifyChanged() => OnChanged.InvokeAsync();

    // The seed actually used by this cosigner: its own words, or the shared
    // top-level seed when it leaves the field empty (mirrors Owner.razor's payload
    // build). Empty when neither is available yet.
    [Parameter] public string? TopLevelSeed { get; set; }

    string EffectiveSeed =>
        !string.IsNullOrWhiteSpace(Vm.SeedWords) ? Vm.SeedWords! : (TopLevelSeed ?? "");

    // Recomputed on each render (cheap: one PBKDF2 + one EC multiply). @bind fires on
    // change, so the value refreshes when the user leaves the seed/passphrase field.
    string ComputedFingerprint =>
        string.IsNullOrWhiteSpace(EffectiveSeed) ? "" : SafeCompute(EffectiveSeed, Vm.Passphrase);

    string FingerprintHint =>
        string.IsNullOrWhiteSpace(EffectiveSeed)
            ? "Enter seed words (or a top-level seed) to see the fingerprint."
            : !string.IsNullOrWhiteSpace(Vm.SeedWords)
                ? "Derived from this cosigner's seed + passphrase. Match it against your wallet."
                : "Derived from the top-level seed + this cosigner's passphrase.";

    // Never let a compute error break the form — an unparseable seed simply shows "—".
    static string SafeCompute(string seed, string? passphrase)
    {
        try
        {
            return Bip32MasterFingerprint
                .Compute(seed, string.IsNullOrEmpty(passphrase) ? null : passphrase)
                .ToString();
        }
        catch
        {
            return "";
        }
    }
}
