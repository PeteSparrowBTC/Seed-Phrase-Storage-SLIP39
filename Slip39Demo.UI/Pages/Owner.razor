@page "/owner"
@using System.Text
@using CSharpFunctionalExtensions
@using Slip39Demo.Core
@using Slip39Demo.Core.Age
@using Slip39Demo.Core.Bip32
@using Slip39Demo.Core.Bundle
@using Slip39Demo.Core.Payload
@using Slip39Demo.Core.Pgp
@using Slip39Demo.Core.Slip39
@using Slip39Demo.Core.Verification
@using Slip39Demo.Core.Wallet
@using Slip39Demo.UI.Services
@using Slip39Demo.UI.Shared

<PageTitle>Create backup — SLIP-39 + age</PageTitle>

<div class="page-head">
    <h1 class="with-icon"><Icon Name="backup" /> Create backup</h1>
    @* href without a leading slash, deliberately. A leading slash resolves against the
       domain root and ignores <base href>, so on GitHub Pages, where the app is served
       from /slip39-backup/, "/" sent the visitor to petesparrowbtc.github.io/ and "/owner"
       to petesparrowbtc.github.io/owner. Both are outside the app and both are hard 404s:
       the landing page's own buttons walked the user off the site. It went unnoticed
       because the Tauri build is served from a root base, where the absolute form happens
       to work. Base-relative resolves correctly in both hosts. *@
    <a href="./" class="btn btn-sm">← Home</a>
</div>

<ConnectivityBanner OnlineChanged="v => machineOnline = v" />

<div class="split">
    <div>
        <div class="panel">
            <div class="panel-header">Wallet metadata</div>
            <div class="panel-body">
                <div class="field">
                    <label class="field-label">Label</label>
                    <input class="input" @bind="model.Label" placeholder="e.g. Main wallet 2026" />
                </div>
                <div class="field">
                    <label class="field-label">
                        Top-level seed words (shared-seed mode; leave empty for per-cosigner seeds)
                    </label>
                    <input class="input input-mono" @bind="model.TopLevelSeedWords"
                           placeholder="abandon ability able about above absent absorb abstract absurd abuse access accident" />
                </div>
                <div class="field">
                    <label class="field-label">Descriptor (leave empty and it is computed)</label>
                    <input class="input input-mono" @bind="model.Descriptor"
                           placeholder="wsh(sortedmulti(2, ...))" />
                    @* Computed is the default because this tool already holds every
                       cosigner seed and passphrase at once, which nothing else in an
                       offline session does, so it can derive the descriptor without a
                       second program and without a hand-typed string. Pasting overrides
                       it, for a wallet that already exists on a path this does not
                       compute; nothing here parses or checks what you paste. *@
                    <div class="hint">
                        With two or more cosigners this is derived from their seeds, along
                        with the wallet's first receive address for checking the backup
                        later. Paste one to record an existing wallet instead.
                    </div>
                </div>
            </div>
        </div>

        @* THE BACKUP KEY, k. Optional by design: empty means the generator, which is
           what this tool has always done. The two fields exist so k can be transcribed
           from a tool that derived it from physical dice, giving it an origin the owner
           can account for and recompute.

           The copy here is deliberately careful about what dice buy. They do NOT remove
           the random number generator from this backup: age generates its own file key
           with it and the payload is encrypted under that, while k only wraps it. Saying
           otherwise would be a claim this tool cannot support, so it does not make it. *@
        <div class="panel">
            <div class="panel-header">Backup key (optional)</div>
            <div class="panel-body">
                <p class="hint">
                    Leave both fields empty and <strong>Generate</strong> creates the 32-byte
                    key with this machine's random number generator, exactly as before. Fill
                    them in to use a key you derived elsewhere and can recompute, for example
                    with <code>dice-to-seed</code> from physical dice.
                </p>

                @* Bound on change, not on each keystroke, for the same reason the cosigner
                   fingerprint is: a re-render of this page recomputes every cosigner's
                   PBKDF2, which is slow enough in the WASM build to be felt if it ran on
                   all 64 characters as they were typed. The state below therefore refreshes
                   when the field is left. *@
                <div class="field">
                    <label class="field-label">Key, 64 hex characters</label>
                    <input class="input input-mono" @bind="model.BackupKeyHex"
                           placeholder="64 hex characters; spaces and line breaks are ignored" />
                </div>

                <div class="field">
                    <label class="field-label">Check code, 4 characters</label>
                    <input class="input input-mono" @bind="model.BackupKeyCheckCode"
                           placeholder="4 hex characters" />
                    <div class="hint">
                        The check code catches a mistyped key. It is the first four characters
                        of the SHA-256 of the key's printed lowercase hex, so it can be
                        reproduced from what is on the other screen with
                        <code>printf '%s' "$K_HEX" | sha256sum | cut -c1-4</code>. Sixteen bits
                        of typo detection, not a security control. Required whenever a key is
                        entered.
                    </div>
                </div>

                @* Live account of what Generate will use, so the state is never a surprise at
                   the moment of clicking. A refusal here is the same refusal Generate would
                   report, from the same function, shown early.

                   Two presentations and no third: a state that will refuse gets banner-loud,
                   the same treatment every other blocking condition on this page gets, and a
                   state that will proceed gets a hint. There is deliberately no middle
                   rendering, because a caveat styled as body text beside a key field reads as
                   advice, and nothing here is advice. *@
                @foreach (var note in BackupKeyNotes())
                {
                    @if (note.Refuses)
                    {
                        <div class="banner banner-loud">@note.Message</div>
                    }
                    else
                    {
                        <p class="hint">@note.Message</p>
                    }
                }

                <p class="hint">
                    Dice do not take a random number generator out of this backup. age
                    generates its own file key with this machine's generator and encrypts the
                    payload under that; the key above only wraps it. What dice buy is a key
                    whose origin you can account for and recompute, which is worth having and
                    is a different claim.
                </p>
            </div>
        </div>

        <p class="section-label">Cosigners</p>
        @for (var i = 0; i < model.Cosigners.Count; i++)
        {
            var idx = i;
            // @key ties each editor to its cosigner object. Without it, Blazor
            // matches editors by position; once the form re-renders on every edit
            // (live fingerprints/warnings), that mis-associates state and typed
            // passphrases/seeds fail to commit for the 2nd+ cosigner.
            <CosignerEditor @key="model.Cosigners[idx]" Vm="model.Cosigners[idx]" Index="idx"
                            TopLevelSeed="@model.TopLevelSeedWords"
                            Removable="model.Cosigners.Count > 1"
                            OnChanged="StateHasChanged"
                            OnRemove="() => RemoveCosigner(idx)" />
        }
        <button class="btn btn-sm" @onclick="AddCosigner">+ Add cosigner</button>

        @* The wallet's signing policy, which nothing else in this form carries. The group
           threshold further down is about SLIP-39 shares: how many pieces of paper
           reconstruct the key that opens the backup. This is how many cosigners must sign
           a transaction, and it goes into the computed descriptor. Only asked when there
           is more than one cosigner, because with one there is nothing to choose. *@
        @if (model.Cosigners.Count > 1)
        {
            <div class="field">
                <label class="field-label">
                    Signatures required (of @model.Cosigners.Count cosigners)
                </label>
                <input class="input" type="number" min="2" max="@model.Cosigners.Count"
                       @bind="model.SignaturesRequired" placeholder="signatures required" />
                <div class="hint">
                    The wallet's own signing policy, not the share threshold. 2 of 2 or
                    better; a 1-of-N wallet lets any single cosigner spend alone, which is
                    what splitting the key into shares exists to prevent.
                </div>
            </div>
        }

        @* Live sanity checks on the cosigner set. Two cosigners deriving from the
           same secret cannot add multisig security, so surface that before the user
           commits a broken backup. Non-blocking: warns, does not prevent Generate. *@
        @foreach (var w in CosignerWarnings())
        {
            <div class="banner @(w.Strong ? "banner-loud" : "banner-warn")">@w.Message</div>
        }

        <GroupConfigEditor Groups="model.Groups"
                           GroupThreshold="model.GroupThreshold"
                           GroupThresholdChanged="v => model.GroupThreshold = v" />
    </div>

    <div class="split-sticky">
        <div class="panel">
            <div class="panel-header">Generate</div>
            <div class="panel-body">
                @* Names the key's origin rather than always claiming a random one: the
                   sentence has to stay true once a key can be pasted. *@
                <p class="hint">
                    Clicking <strong>Generate</strong> takes the 32-byte key
                    (@(BackupKeyEntry.IsSupplied(model.BackupKeyHex, model.BackupKeyCheckCode)
                        ? "the one entered above"
                        : "freshly generated at random")), SLIP-39-splits
                    it, encrypts the wallet payload with age, and downloads everything as one
                    dated zip (for example <code>slip39-wallet-backup-main-wallet-2026-07-19.zip</code>).
                </p>

                @* Airgap attestation: the tool cannot PROVE the environment is safe
                   (a web page cannot detect Tails), so a real backup requires the
                   offline probe to pass AND this deliberate confirmation. Anything
                   less is watermarked INSECURE-TEST. *@
                <label class="check">
                    <input type="checkbox" id="airgap-attest" @bind="attested" />
                    <span>
                        I confirm this machine is running Tails, is disconnected from
                        every network, and will stay disconnected until this session
                        ends. This is required for a real backup, not advised.
                    </span>
                </label>
                @* An attestation about the network cannot answer a question about
                   provenance, so on a hosted copy the checkbox is left usable (it
                   still describes something the user knows) and told plainly that it
                   changes nothing here. Disabling it would invite the reader to hunt
                   for whatever would enable it. *@
                @if (!originIsLocal)
                {
                    <p class="hint hint-loud">
                        Ticking that box cannot make this copy safe. It was served by
                        @ServingOrigin.Describe(Navigation.BaseUri), so the code running
                        right now is code you cannot check against the repository, and
                        every backup made here is watermarked INSECURE-TEST whatever you
                        confirm. Download the AppImage and run it on an offline Tails
                        session for a real one.
                    </p>
                }

                @if (IsTestOnly)
                {
                    <div class="banner banner-warn">
                        ⚠ This backup will be marked <strong>INSECURE-TEST</strong>
                        (@(machineOnline != false ? "internet reachable" : "environment not attested")).
                        Usable for practice only, never for real funds.
                    </div>
                }

                @if (errorMessage is not null)
                {
                    <div class="banner banner-loud">@errorMessage</div>
                }
                @* The result, as labelled rows rather than one run-on sentence. The
                   fingerprint and the filename are the two things a reader has to
                   copy or compare against something else, so they get their own
                   monospaced rows instead of being buried mid-paragraph. *@
                @if (success is not null)
                {
                    <div class="banner @(success.TestOnly ? "banner-warn" : "banner-ok")">
                        <strong>
                            @(success.TestOnly
                                ? "INSECURE-TEST backup. Practice only, never for real funds."
                                : "Backup created.")
                        </strong>

                        <div class="field">
                            <span class="field-label">Shares written</span>
                            <p class="hint">@success.ShareCount</p>
                        </div>

                        <div class="field">
                            <span class="field-label">Independently verified ✓</span>
                            <p class="hint">
                                Recovered by slip39-js and typage, and this build read a
                                backup those libraries wrote.
                            </p>
                        </div>

                        @* Which key wrapped this backup is a fact worth recording where the
                           owner can see it, so the source is named. The key itself is never
                           shown: it appears only in the field it was typed into.

                           The Pasted wording claims the seed comparison actually happened, and
                           that claim holds by construction rather than by hope. Reaching this
                           panel means TryBuild passed three gates in order: at least one
                           non-blank seed exists, every non-blank seed read as BIP-39 (an
                           unreadable one refuses), and none of them matched the key. So the
                           number of seeds compared is at least one whenever this line renders.
                           This panel is the record the owner keeps after the live state is
                           gone, so a sentence here that could be false would be worse than no
                           sentence. *@
                        <div class="field">
                            <span class="field-label">Backup key</span>
                            <p class="hint">
                                @(success.KeySource == BackupKeySource.Pasted
                                    ? "Entered by you, check code verified, and checked against the seed words in this form."
                                    : "Generated here: 32 random bytes from this machine's generator.")
                            </p>
                        </div>

                        <div class="field">
                            <span class="field-label">Wallet master fingerprint</span>
                            <p class="mono-block">@success.Fingerprint</p>
                        </div>

                        @* The check worth running today, while the wallet is still in front
                           of you: rebuild it in wallet software and compare this address.
                           The fingerprint above cannot catch a wrong derivation path, script
                           type, key ordering or threshold, because it is taken at the master
                           key and is identical whatever is derived below it. This address
                           changes completely if any of the four is wrong. Shown only when the
                           descriptor was computed here; a pasted one was parsed by nothing. *@
                        @if (success.FirstReceiveAddress is not null)
                        {
                            <div class="field">
                                <span class="field-label">First receive address (computed)</span>
                                <p class="mono-block">@success.FirstReceiveAddress</p>
                                <p class="hint">
                                    Also in verification-record.txt. Rebuild this wallet in any
                                    wallet software from the same seeds and compare: if the first
                                    receive address matches, the descriptor in this backup
                                    describes the wallet you meant.
                                </p>
                            </div>
                        }

                        <div class="field">
                            <span class="field-label">Downloaded as</span>
                            <p class="mono-block">@success.FileName</p>
                        </div>
                    </div>
                }

                @* The save dialog was cancelled or closed: no file exists anywhere. The
                   backup already generated is kept in pendingOutcome/pendingFileName rather
                   than discarded, so "Save again" retries with the identical bytes and name
                   instead of regenerating, which would mint a different key and different
                   shares. Text carries the state, not just banner-warn's colour: a reader
                   must be able to tell what happened from the words alone. *@
                @if (saveCancelled)
                {
                    <div class="banner banner-warn">
                        <strong>Nothing was saved.</strong>
                        <p class="hint">
                            The save dialog closed before a file was written, so nothing
                            changed on disk. The backup already generated still exists and
                            has not changed; saving again writes the exact same shares and
                            files, not a new backup.
                        </p>
                        <button class="btn btn-primary" @onclick="RetrySaveAsync" disabled="@isGenerating">
                            @if (isGenerating)
                            {
                                <span class="spinner"></span>
                                <text>Saving…</text>
                            }
                            else
                            {
                                <text>Save again</text>
                            }
                        </button>
                    </div>
                }

                <button class="btn btn-primary btn-block" @onclick="GenerateAsync"
                        disabled="@(isGenerating || HasBlockingCosignerDuplicate())">
                    @if (isGenerating)
                    {
                        <span class="spinner"></span>
                        <text>Generating…</text>
                    }
                    else
                    {
                        <text>Generate</text>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@if (transcript is not null)
{
    <div class="panel" style="margin-top:1rem">
        <div class="panel-header">
            <span>How your payload was encrypted</span>
            <button class="btn btn-sm" @onclick="() => showTranscript = !showTranscript">
                @(showTranscript ? "Hide details" : "Show details")
            </button>
        </div>
        <div class="panel-body">
            <p class="hint">@transcript.Summary</p>
            @if (showTranscript)
            {
                @* A terminal-style log: the reader sees the command that ran and
                   what it printed back, not a claim that something happened. Each
                   kind carries a prefix as well as a colour, so the distinction
                   survives a grayscale screenshot. *@
                <div class="transcript">
                    @foreach (var line in transcript.Lines)
                    {
                        @switch (line.Kind)
                        {
                            case TranscriptLineKind.Command:
                                <div class="t-command">$ @line.Text</div>
                                break;
                            case TranscriptLineKind.Output:
                                <div class="t-output">&gt; @line.Text</div>
                                break;
                            case TranscriptLineKind.Warning:
                                <div class="t-warning">! @line.Text</div>
                                break;
                            default:
                                <div class="t-note"># @line.Text</div>
                                break;
                        }
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Inject] IFileDownloader Downloader { get; set; } = null!;
    [Inject] IIndependentVerifier Verifier { get; set; } = null!;
    [Inject] IPayloadEncryptor Encryptor { get; set; } = null!;
    [Inject] IOuterLockVerifier OuterLock { get; set; } = null!;
    [Inject] NavigationManager Navigation { get; set; } = null!;

    readonly OwnerFormModel model = new();
    bool isGenerating;
    string? errorMessage;
    GenerationSummary? success;

    // True right after a save attempt that produced no file: the dialog was
    // cancelled or closed. Mutually exclusive with success, and the trigger for
    // the "Save again" banner.
    bool saveCancelled;

    // The already-built bundle and the facts it was built with, kept around so a
    // cancelled save can be retried without regenerating. Regenerating would draw
    // a fresh random key and produce different shares, which is exactly what a
    // mis-clicked Cancel must not cost the user. Deliberately not reset when a
    // save attempt fails: the retry button depends on them still being here.
    BuildOutcome? pendingOutcome;
    string? pendingFileName;
    bool pendingIsTestOnly;

    // What the result panel shows. A record rather than a formatted string, so the
    // page decides the layout and the fingerprint and filename can each sit in their
    // own monospaced row for copying and comparing.
    sealed record GenerationSummary(
        bool TestOnly, int ShareCount, Bip32Fingerprint Fingerprint, string FileName,
        BackupKeySource KeySource, string? FirstReceiveAddress);

    // Environment gate. machineOnline: null until the first probe completes.
    // A REAL (unwatermarked) backup requires probe==offline AND the user's
    // explicit attestation — everything else is INSECURE-TEST. Fail-safe:
    // unknown probe state counts as online.
    bool? machineOnline;
    bool attested;

    // The third condition, and the one the other two cannot substitute for: these bytes
    // must not have been served by somebody else. An offline machine running code from a
    // server the user cannot audit is not a safe place for a seed, however many boxes are
    // ticked, and the attestation is about the network rather than about provenance. Read
    // once, because where the app came from cannot change while it runs.
    bool originIsLocal;

    // Held after a successful generate so the user can read what actually
    // happened. Contains no key material and no plaintext by construction.
    EncryptionTranscript? transcript;
    bool showTranscript;
    bool IsTestOnly => machineOnline != false || !attested || !originIsLocal;

    protected override void OnInitialized() =>
        originIsLocal = ServingOrigin.IsLocal(Navigation.BaseUri);

    async Task GenerateAsync()
    {
        errorMessage = null;
        success = null;
        saveCancelled = false;
        isGenerating = true;
        try
        {
            await Task.Yield(); // let the spinner render before CPU-bound work

            var build = await TryBuild();
            if (build.IsFailure)
            {
                errorMessage = build.Error;
                return;
            }
            var outcome = build.Value;

            // Independent round-trip gate: the backup must be recoverable by
            // third-party implementations (slip39-js + typage) that share no code
            // with the C# generation stack. Every share participates in at least
            // one subset. On ANY failure the download is refused — handing out a
            // possibly-unrecoverable backup is the worst outcome for a backup tool.
            var verified = await Verifier.VerifyAsync(
                outcome.VerifySubsets, outcome.PayloadAge, outcome.PayloadText);
            if (verified.IsFailure)
            {
                errorMessage =
                    "Backup REFUSED — the generated shares did not pass independent "
                    + $"verification. Nothing was downloaded. Details: {verified.Error}";
                return;
            }

            // The gate above proves this build writes something others can read.
            // This one proves it can READ what others write, which is what
            // Recoverer mode is asked to do when an heir turns up with a
            // payload.age and shares that passed through other tools on the way.
            // Both must hold before anything leaves the machine: a build that
            // cannot read a foreign backup fails at recovery, and recovery is the
            // one moment where nobody is around to work around a surprise.
            var foreignReadable = await Verifier.VerifyForeignReadableAsync();
            if (foreignReadable.IsFailure)
            {
                errorMessage =
                    "Backup REFUSED — this build failed the cross-implementation self-test: "
                    + "it could not read a backup written by the independent implementations. "
                    + $"Nothing was downloaded. Details: {foreignReadable.Error}";
                return;
            }

            // Name the download after what it is + when it was made, so a user
            // juggling several wallet backups can tell them apart on disk instead
            // of a pile of identical "output.zip" files. Shape:
            //   slip39-wallet-backup-<label-slug>-<yyyy-MM-dd>.zip   (label present)
            //   slip39-wallet-backup-<yyyy-MM-dd>.zip                (no label)
            transcript = outcome.Transcript;
            pendingOutcome = outcome;
            pendingFileName = BuildBundleFileName(model.Label, IsTestOnly);
            pendingIsTestOnly = IsTestOnly;
            await AttemptSaveAsync();
        }
        finally
        {
            isGenerating = false;
        }
    }

    // Hands the already-built bundle to the downloader and records what happened.
    // Called once from GenerateAsync right after a build, and again from
    // RetrySaveAsync after a cancelled attempt, both times with the same
    // pendingOutcome/pendingFileName, so a retry can only ever save the backup
    // that was actually generated, never a different one.
    async Task AttemptSaveAsync()
    {
        if (pendingOutcome is null || pendingFileName is null)
            return;

        var saved = await Downloader.DownloadAsync(pendingFileName, pendingOutcome.Bundle, "application/zip");
        if (saved)
        {
            success = new GenerationSummary(
                pendingIsTestOnly, pendingOutcome.MnemonicCount, pendingOutcome.Fingerprint,
                pendingFileName, pendingOutcome.KeySource, pendingOutcome.FirstReceiveAddress);
            saveCancelled = false;
        }
        else
        {
            success = null;
            saveCancelled = true;
        }
    }

    // The "Save again" button. Shares isGenerating with GenerateAsync so the two
    // cannot run at once and the button disables itself while a save is pending,
    // including against a second, third, ... cancellation: pendingOutcome and
    // pendingFileName are never cleared by a failed attempt, so nothing here
    // depends on how many times the user has already said no.
    async Task RetrySaveAsync()
    {
        isGenerating = true;
        try
        {
            await AttemptSaveAsync();
        }
        finally
        {
            isGenerating = false;
        }
    }

    // Everything GenerateAsync needs after a successful build: the bundle to hand
    // out, display facts, and the raw pieces the independent verifier re-checks.
    sealed record BuildOutcome(
        byte[] Bundle,
        int MnemonicCount,
        Bip32Fingerprint Fingerprint,
        IReadOnlyList<IReadOnlyList<string>> VerifySubsets,
        byte[] PayloadAge,
        string PayloadText,
        EncryptionTranscript Transcript,
        BackupKeySource KeySource,
        // Null unless the descriptor was computed here. The result panel shows it because
        // comparing it against wallet software is the check the owner is meant to run, and
        // a check nobody sees is a check nobody runs.
        string? FirstReceiveAddress);

    // Pure projection from the view-model to the bundle bytes. Returns a Result so
    // every legitimate failure surface (no seed, age failure, SLIP-39 failure) is
    // captured cleanly without exceptions reaching the UI layer.
    async Task<Result<BuildOutcome>> TryBuild()
    {
        var firstSeed = !string.IsNullOrWhiteSpace(model.TopLevelSeedWords)
            ? model.TopLevelSeedWords
            : model.Cosigners.Select(c => c.SeedWords).FirstOrDefault(s => !string.IsNullOrWhiteSpace(s));
        if (string.IsNullOrWhiteSpace(firstSeed))
            return Result.Failure<BuildOutcome>("At least one seed must be provided (either top-level or per-cosigner).");

        // Block backups that encode a degenerate multisig: two cosigners resolving to
        // the identical key (same effective seed + passphrase + derivation path) add no
        // security and some wallets reject duplicate keys outright.
        var duplicate = CosignerWarnings().FirstOrDefault(w => w.Strong);
        if (duplicate is not null)
            return Result.Failure<BuildOutcome>(duplicate.Message);

        var firstPp = model.Cosigners.Select(c => c.Passphrase).FirstOrDefault(p => !string.IsNullOrEmpty(p));

        // Before the payload, because the payload carries the result. A refusal here is
        // the same class of stop as an unusable backup key: named, and nothing generated.
        var wallet = ResolveDescriptor();
        if (wallet.IsFailure)
            return Result.Failure<BuildOutcome>(wallet.Error);

        var payload = new PayloadV1_1(
            SchemaVersion: "1.1",
            Created: $"{DateTime.UtcNow:yyyy-MM-ddTHH:mm:ssZ}",
            Label: model.Label,
            TopLevelSeedWords: string.IsNullOrWhiteSpace(model.TopLevelSeedWords) ? null : model.TopLevelSeedWords,
            Cosigners: model.Cosigners.Select(c => new Cosigner(
                Id: c.Id,
                WalletType: c.WalletType,
                Passphrase: string.IsNullOrEmpty(c.Passphrase) ? null : c.Passphrase,
                DerivationPath: c.DerivationPath,
                SeedWords: string.IsNullOrEmpty(c.SeedWords) ? null : c.SeedWords,
                // Auto-computed from this cosigner's effective seed + passphrase — the
                // tool has both, so it records the real master fingerprint rather than
                // trusting a hand-typed (possibly wrong) value.
                XpubFingerprint: ComputeCosignerFingerprint(c))).ToList(),
            Descriptor: wallet.Value.Text,
            // Single-group threshold display; multi-group uses the first group's
            // shape as a primary display. The full group structure is reflected in
            // the README per share regardless.
            Threshold: $"{model.Groups[0].Threshold}-of-{model.Groups[0].Count}",
            Slip39Extendable: true,
            Notes: null);

        // Emitted through the round-trip gate, not through PayloadEmitter directly: the
        // text must parse back into exactly this payload before anything is encrypted.
        // The format writes each value on one line, so a passphrase with a line break in
        // it (or, before the parser was fixed, a leading space) produced a backup that
        // passed every other check and recovered a DIFFERENT wallet. See PayloadRoundTrip.
        var emitted = PayloadRoundTrip.EmitChecked(payload);
        if (emitted.IsFailure)
            return Result.Failure<BuildOutcome>(emitted.Error);
        var payloadText = emitted.Value;
        var payloadBytes = Encoding.UTF8.GetBytes(payloadText);

        // k, the SLIP-39 master secret. Either the 32 bytes the user entered above or 32
        // fresh random bytes, and never a silent substitution of one for the other: if a
        // key was supplied and is unusable (wrong length, check code mismatch, or the same
        // value as this wallet's own BIP-39 entropy), Resolve fails and generation stops
        // with the reason named. See BackupKeyEntry for why the collision case is a refusal
        // rather than a warning.
        var keyChoice = BackupKeyEntry.Resolve(
            model.BackupKeyHex, model.BackupKeyCheckCode, SeedWordsInForm());
        if (keyChoice.IsFailure)
            return Result.Failure<BuildOutcome>(keyChoice.Error);
        var k = keyChoice.Value.Key;

        // Encryption goes through the injected encryptor, not straight to AgeSharp:
        // the Tails AppImage runs the official age binary as a separate program,
        // and returns a transcript of exactly what it did so the user can read it
        // rather than take our word. The browser demo stays in-process.
        var cipherResult = await Encryptor.EncryptAsync(payloadBytes, k);
        if (cipherResult.IsFailure)
            return Result.Failure<BuildOutcome>(cipherResult.Error);
        var ciphertext = cipherResult.Value.Ciphertext;

        var cfg = new GroupConfig(
            GroupThreshold: model.GroupThreshold,
            Groups: model.Groups.Select(g => new ShareGroup(g.Name, g.Threshold, g.Count)).ToList(),
            Extendable: true);

        var splitResult = Slip39Wrapping.SplitKey(k, cfg);
        if (splitResult.IsFailure)
            return Result.Failure<BuildOutcome>(splitResult.Error);
        var mnemonics = splitResult.Value;

        // Walk the group-flat mnemonic list and label each as group/index-in-group
        // so the README and the share zip filename carry the right naming.
        var shareZips = new List<(string FileName, byte[] ZipBytes)>();
        var flat = 0;
        for (var gi = 0; gi < cfg.Groups.Count; gi++)
        {
            var g = cfg.Groups[gi];
            for (var mi = 0; mi < g.Count; mi++)
            {
                var readme = ReadmeTemplate.Build(g.Name, mi + 1, g.Count, $"{DateTime.UtcNow:yyyy-MM-dd}", AppVersion.Current, IsTestOnly);
                var folder = ShareFolder.Build(readme, mnemonics[flat]);
                var zip = ShareZipWriter.Write(folder);
                var fileName = cfg.Groups.Count == 1
                    ? $"share-{mi + 1}-of-{g.Count}.zip"
                    : $"{g.Name}-share-{mi + 1}-of-{g.Count}.zip";
                shareZips.Add((fileName, zip));
                flat++;
            }
        }

        // Second, independent envelope around the age file. Nesting composes:
        // an attacker must break BOTH formats, so the wallet survives a break in
        // either. It also lifts the post-quantum margin from 2^64 to 2^128,
        // because age's 128-bit file key is what Grover would halve.
        var wrapped = PgpEnvelope.EncryptArmored(ciphertext, k);
        if (wrapped.IsFailure)
            return Result.Failure<BuildOutcome>(wrapped.Error);

        // Outer-lock gate. The age layer was written by the official age binary, so it is
        // already the work of an implementation we did not write; this layer was written
        // in-process by BouncyCastle, and asking BouncyCastle to open it would prove only
        // that it is self-consistent. So the system's own GnuPG opens it and must return
        // the age file byte for byte.
        //
        // Runs here, inside the build, so k does not have to travel out on BuildOutcome
        // and sit on the page for the lifetime of the result panel.
        var outerLock = await OuterLock.VerifyAsync(wrapped.Value, ciphertext, k);
        var refusal = OuterLockRefusal(outerLock);
        if (refusal is not null)
            return Result.Failure<BuildOutcome>(refusal);

        var fingerprint = Bip32MasterFingerprint.Compute(firstSeed, firstPp);
        var record = VerificationRecord.Build(
            createdDate: $"{DateTime.UtcNow:yyyy-MM-dd}",
            toolVersion: AppVersion.Current,
            label: model.Label ?? "",
            mnemonicsInOrder: mnemonics,
            // Fingerprints the file the owner actually holds. Hashing the inner age
            // bytes would name a file nobody has, so a dry-run check years later could
            // never match.
            payloadAgeBytes: Encoding.UTF8.GetBytes(wrapped.Value),
            walletMasterFingerprint: fingerprint,
            // The descriptor's own text stays out of the record: it carries account
            // xpubs, and this file is the one the record tells the owner to print and to
            // keep in a password manager. The address is the part that may travel.
            descriptorProvenance: wallet.Value.Provenance,
            firstReceiveAddress: wallet.Value.FirstReceiveAddress);

        var bundle = OutputBundleBuilder.Build(shareZips, wrapped.Value, record);

        // Subsets for the independent verifier: every share covered, each subset
        // exactly satisfying the threshold structure (slip39-js rejects extras).
        var verifySubsets = VerificationSubsets.BuildCoveringSubsets(cfg, mnemonics);

        // One transcript covering both locks, in the order they were applied. When the
        // outer check could not run (a test-only backup on a machine without gpg) the
        // transcript says so in a warning rather than falling silent, so a reader can tell
        // an unchecked backup from a checked one.
        var transcriptLines = outerLock.Outcome == OuterLockOutcome.Unavailable
            ? (IReadOnlyList<TranscriptLine>)[new TranscriptLine(TranscriptLineKind.Warning,
                "The outer OpenPGP lock was NOT opened by anything independent of the library "
                + $"that wrote it. {outerLock.Detail}")]
            : outerLock.Transcript;

        var transcript = cipherResult.Value.Transcript with
        {
            Lines = [..cipherResult.Value.Transcript.Lines, ..transcriptLines],
        };

        return new BuildOutcome(bundle, mnemonics.Count, fingerprint, verifySubsets, ciphertext, payloadText,
            transcript, keyChoice.Value.Source, wallet.Value.FirstReceiveAddress);
    }

    // What an outer-lock outcome costs. Kept apart from the check itself so the rule is
    // legible in one place: returns the refusal message, or null to continue.
    //
    // A REAL backup refuses on anything short of Verified. "GnuPG disagreed" and "GnuPG is
    // not here" are different facts about the machine but the same fact about the backup:
    // nothing independent has opened its outer layer, and that layer is the one written by
    // code from this repository. Tails ships GnuPG, so on the machine this tool is built
    // for the Unavailable branch does not fire; where it does, the message says what to do.
    //
    // An INSECURE-TEST backup reports and continues. It is watermarked, it is practice, and
    // the hosted demo runs in a browser that cannot reach gpg at all, so refusing there
    // would leave nothing to demonstrate. Failed still refuses even then: that one is not a
    // fact about the machine, it means this build produced an envelope gpg cannot open.
    string? OuterLockRefusal(OuterLockVerification verification) =>
        verification.Outcome switch
        {
            OuterLockOutcome.Verified => null,
            OuterLockOutcome.Failed =>
                "Backup REFUSED — GnuPG could not open the outer lock of the file this build "
                + $"just produced. Nothing was saved. Details: {verification.Detail}",
            _ when IsTestOnly => null,
            _ => "Backup REFUSED — the outer OpenPGP lock could not be checked by an "
                 + "implementation independent of the one that wrote it, and this is a real "
                 + $"backup. Nothing was saved. Details: {verification.Detail}",
        };

    // Every seed the form holds: the shared top-level one and each cosigner's own words.
    // All of them are compared against a pasted key, not just the first, because the
    // collision is just as total when the reused roll log belongs to the third cosigner.
    // The descriptor that goes into the payload, where it came from, and the first receive
    // address when there is one. Address is null unless the descriptor was computed here,
    // because nothing in this tool parses a descriptor somebody else wrote.
    sealed record WalletDescription(string? Text, DescriptorProvenance Provenance, string? FirstReceiveAddress);

    // Computed by default, pasted as the override.
    //
    // The order matters and is deliberate: a pasted descriptor wins outright and is stored
    // as typed. Somebody backing up a wallet that already exists, on a path or script type
    // this tool does not compute, must be able to record it; and this tool does not parse
    // what they paste, so it can say nothing about it beyond where it came from.
    //
    // With no pasted descriptor and two or more cosigners, the descriptor is derived. A
    // failure there STOPS generation rather than falling back to an empty descriptor
    // field: the owner asked for a multisig backup, and one whose descriptor is missing is
    // a backup whose executor cannot rebuild the wallet even holding every seed.
    Result<WalletDescription> ResolveDescriptor()
    {
        if (!string.IsNullOrWhiteSpace(model.Descriptor))
            return new WalletDescription(model.Descriptor!.Trim(), DescriptorProvenance.Pasted, null);

        // One cosigner is a single-signature wallet, which has no descriptor here and
        // never had one. Unchanged behaviour, deliberately: this feature adds a computed
        // descriptor for multisig, it does not start refusing backups that worked before.
        if (model.Cosigners.Count < 2)
            return new WalletDescription(null, DescriptorProvenance.NotRecorded, null);

        var cosigners = model.Cosigners
            .Select(c => new MultisigCosigner(
                Id: c.Id,
                // The seed this cosigner actually signs with: its own words, or the
                // shared top-level ones. Same rule the fingerprint column already uses.
                SeedWords: !string.IsNullOrWhiteSpace(c.SeedWords) ? c.SeedWords! : (model.TopLevelSeedWords ?? ""),
                Passphrase: c.Passphrase,
                DerivationPath: c.DerivationPath))
            .ToList();

        return MultisigWallet.Describe(cosigners, model.SignaturesRequired)
            .Map(wallet => new WalletDescription(
                wallet.Descriptor, DescriptorProvenance.Computed, wallet.FirstReceiveAddress));
    }

    IEnumerable<string?> SeedWordsInForm() =>
        model.Cosigners.Select(c => c.SeedWords).Prepend(model.TopLevelSeedWords);

    // Refuses is the whole distinction: either this state stops generation or it describes
    // what generation will do. Nothing in between, so nothing that blocks can be styled as
    // if it were a note.
    sealed record BackupKeyNote(bool Refuses, string Message);

    // The live account of k's origin. Deliberately reports the same refusals Generate
    // would, computed from the same functions, so the panel cannot drift from the decision.
    //
    // It never renders the key, and it never renders the correct check code: showing the
    // code this build computed would turn the typo detector into a fill-in-the-blank
    // prompt, and the whole value of the code is that it was transcribed from the other
    // screen independently.
    IReadOnlyList<BackupKeyNote> BackupKeyNotes()
    {
        if (!BackupKeyEntry.IsSupplied(model.BackupKeyHex, model.BackupKeyCheckCode))
            return [new BackupKeyNote(false,
                "Both fields empty. Generate will create the key with this machine's random "
                + "number generator.")];

        var read = BackupKeyEntry.Read(model.BackupKeyHex, model.BackupKeyCheckCode);
        if (read.IsFailure)
            return [new BackupKeyNote(true, read.Error)];

        var scan = BackupKeyEntry.ScanForSeedCollision(read.Value, SeedWordsInForm());
        if (scan.IsFailure)
            return [new BackupKeyNote(true, scan.Error)];

        return [new BackupKeyNote(false,
            "Check code matches. Generate will split this key instead of a generated one"
            + (scan.Value.Compared == 0
                ? ". No seed words have been entered yet, so nothing has been compared against "
                  + "it; generation needs a seed anyway."
                : ", and it is not the BIP-39 entropy of "
                  + (scan.Value.Compared == 1 ? "the seed" : $"any of the {scan.Value.Compared} seeds")
                  + " in this form."))];
    }

    // Builds the download filename: "slip39-wallet-backup" (what it is) + an
    // optional slug of the wallet label + the UTC date (when it was made). Uses
    // the same UtcNow clock as the payload/README timestamps for consistency.
    // Test-only backups are prefixed INSECURE-TEST- so they can never be
    // mistaken for a real backup on disk.
    static string BuildBundleFileName(string? label, bool testOnly)
    {
        var datestamp = DateTime.UtcNow.ToString("yyyy-MM-dd");
        var slug = Slugify(label);
        var name = string.IsNullOrEmpty(slug)
            ? $"slip39-wallet-backup-{datestamp}.zip"
            : $"slip39-wallet-backup-{slug}-{datestamp}.zip";
        return testOnly ? $"INSECURE-TEST-{name}" : name;
    }

    // Lowercases, maps every non-alphanumeric run to a single hyphen, and trims
    // stray hyphens — so "Main wallet 2026!" becomes "main-wallet-2026". Keeps the
    // filename filesystem-safe across Windows/macOS/Linux without extra escaping.
    static string Slugify(string? s) =>
        string.IsNullOrWhiteSpace(s)
            ? ""
            : string.Join('-',
                new string(s.Trim().ToLowerInvariant().Select(ch => char.IsLetterOrDigit(ch) ? ch : '-').ToArray())
                    .Split('-', StringSplitOptions.RemoveEmptyEntries));

    // Computes a cosigner's BIP-32 master fingerprint from its effective seed (own
    // words, or the shared top-level seed) + passphrase. Returns null when no seed is
    // available or the words can't be derived — the field is optional in the payload.
    string? ComputeCosignerFingerprint(CosignerVm c)
    {
        var seed = !string.IsNullOrWhiteSpace(c.SeedWords) ? c.SeedWords : model.TopLevelSeedWords;
        if (string.IsNullOrWhiteSpace(seed))
            return null;
        try
        {
            return Bip32MasterFingerprint
                .Compute(seed, string.IsNullOrEmpty(c.Passphrase) ? null : c.Passphrase)
                .ToString();
        }
        catch
        {
            return null;
        }
    }

    // A cosigner's identity for duplicate detection: the secret that actually signs.
    // Effective seed (own words, or the shared top-level seed) + passphrase + path.
    (string Seed, string Pass, string Path) CosignerIdentity(CosignerVm c) =>
        (!string.IsNullOrWhiteSpace(c.SeedWords) ? c.SeedWords! : (model.TopLevelSeedWords ?? ""),
         c.Passphrase ?? "",
         c.DerivationPath ?? "");

    record CosignerWarning(bool Strong, string Message);

    // Live cosigner-set sanity checks. Strong = blocking (identical key). Soft =
    // advisory (shared seed, weaker multisig).
    IReadOnlyList<CosignerWarning> CosignerWarnings()
    {
        var indexed = model.Cosigners
            .Select((c, i) => (Label: string.IsNullOrWhiteSpace(c.Id) ? $"#{i + 1}" : c.Id, Identity: CosignerIdentity(c)))
            .Where(x => !string.IsNullOrWhiteSpace(x.Identity.Seed))
            .ToList();

        var warnings = new List<CosignerWarning>();

        // BLOCKING: identical seed + passphrase + derivation path — literally the same key.
        foreach (var g in indexed.GroupBy(x => x.Identity).Where(g => g.Count() > 1))
            warnings.Add(new(true,
                $"Cosigners {string.Join(", ", g.Select(x => x.Label))} are the same key "
                + "(identical seed, passphrase, and derivation path). A multisig can't use the same key twice — "
                + "give them different seeds, passphrases, or derivation paths."));

        // ADVISORY: a seed shared by cosigners that aren't all identical (e.g. shared-seed
        // multisig differing by passphrase). Supported, but weaker than independent seeds.
        foreach (var seedGroup in indexed.GroupBy(x => x.Identity.Seed)
                     .Where(g => g.Count() > 1 && g.Select(x => x.Identity).Distinct().Count() > 1))
            warnings.Add(new(false,
                $"Cosigners {string.Join(", ", seedGroup.Select(x => x.Label))} share one seed. "
                + "Multisig is strongest with independent seeds on separate devices."));

        // ADVISORY: whitespace at the start or end of a passphrase. Perfectly legal (BIP-39
        // takes any UTF-8 string) and it now survives the payload format intact, so this
        // does not block. It is still worth saying, because MANUAL-RECOVERY.txt asks a
        // human to read the passphrase off a decrypted file and type it into a wallet, and
        // a leading or trailing space is invisible there. An heir who cannot see it will
        // conclude the backup is broken.
        warnings.AddRange(model.Cosigners
            .Select((c, i) => (
                Label: string.IsNullOrWhiteSpace(c.Id) ? $"#{i + 1}" : c.Id,
                Passphrase: c.Passphrase))
            .Where(x => !string.IsNullOrEmpty(x.Passphrase) && x.Passphrase != x.Passphrase.Trim())
            .Select(x => new CosignerWarning(false,
                $"The passphrase for cosigner {x.Label} begins or ends with a space. That is "
                + "kept exactly as typed and the backup will recover correctly, but the space "
                + "is invisible in the recovery document, so whoever recovers this wallet will "
                + "not see that it is there. Remove it unless it is deliberate.")));

        return warnings;
    }

    bool HasBlockingCosignerDuplicate() => CosignerWarnings().Any(w => w.Strong);

    // The single-signature default a form starts with, and the BIP-48 multisig path.
    // Named because AddCosigner has to recognise the first to replace it with the second.
    const string SingleSigDefaultPath = "m/84'/0'/0'";
    const string MultisigDefaultPath = "m/48'/0'/0'/2'";

    void AddCosigner()
    {
        // A second cosigner makes this a multisig wallet, and multisig has its own BIP-32
        // purpose field: 48h, not 84h. Any cosigner still sitting on the untouched
        // single-sig default is moved, because leaving it there would refuse at Generate
        // for a reason the owner did not cause and cannot see. A path that was EDITED is
        // left alone: that is a deliberate choice, and silently substituting another is
        // exactly what this tool refuses to do elsewhere.
        model.Cosigners
            .Where(c => c.DerivationPath == SingleSigDefaultPath)
            .ToList()
            .ForEach(c => c.DerivationPath = MultisigDefaultPath);

        model.Cosigners.Add(new CosignerVm
        {
            Id = $"cosigner-{model.Cosigners.Count + 1}",
            DerivationPath = MultisigDefaultPath,
        });
    }

    void RemoveCosigner(int idx)
    {
        if (model.Cosigners.Count > 1)
            model.Cosigners.RemoveAt(idx);
    }
}
