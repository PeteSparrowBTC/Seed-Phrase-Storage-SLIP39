<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="bunit" Version="1.34.0" />
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!-- SkippableFact: the PgpEnvelopeInteropTests need a real GnuPG on PATH, and a
         contributor without one should see a skip, not a red suite. It used to be the
         native-age tests too, but those moved to cargo test when encryption moved to the
         Rust shell, and they gate on SLIP39_AGE_DIR there. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="ZXing.Net.Bindings.ImageSharp.V3" Version="0.16.18" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Slip39Demo.Core\Slip39Demo.Core.csproj" />
    <ProjectReference Include="..\Slip39Demo.UI\Slip39Demo.UI.csproj" />
    <!-- ITauriInterop and the services built on it live in the Tauri frontend project;
         referenced here so TauriConnectivityProbeTests can see them. -->
    <ProjectReference Include="..\Slip39Demo.Tauri\Slip39Demo.Tauri.csproj" />
    <!-- AgeSharpPayloadEncryptor lives here now, not in Slip39Demo.UI, precisely so
         Slip39Demo.Tauri cannot reference it; the owner-form tests still need it as a
         test double. -->
    <ProjectReference Include="..\Slip39Demo.Web\Slip39Demo.Web.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- C2SP/CCTV age wire-format vectors, read at runtime by
         CctvScryptArmorVectorTests. Copied to the output directory rather than
         embedded so a failing vector can be inspected as a file next to the
         test binary. -->
    <Content Include="Age\Cctv\testdata\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Backups produced entirely by the third-party JS stack, read back by
         ForeignBackupRoundTripTests. Regenerate with
         tools/independent-verify/make-foreign-fixtures.mjs. -->
    <Content Include="Interop\foreign-backups.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The published BIP-39 test vectors, read at runtime by Bip39MnemonicTests.
         Kept byte for byte as published (all languages, not just the English set
         the tests use) and its SHA-256 asserted, so the suite can show it is
         running the real vectors rather than a copy adjusted until the tests
         went green. -->
    <Content Include="Bip39\Vectors\bip39-english-vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The published BIP-32 test vectors, read at runtime by Bip32VectorTests. Vendored
         as the BIP text itself rather than transcribed into a table, so the chains the
         suite runs are the ones bitcoin/bips publishes. Its SHA-256 is asserted there. -->
    <Content Include="Bip32\Vectors\bip-0032.mediawiki" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
